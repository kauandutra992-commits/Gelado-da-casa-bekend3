# Exemplo local. Nunca envie credenciais reais ao GitHub.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO
# Use PGSSL=true somente se o provedor exigir SSL para a conexão.
PGSSL=false
# Crie um valor secreto forte para proteger a consulta administrativa.
ADMIN_TOKEN=troque-por-um-token-longo-e-aleatorio
